# Nimbus is free-only: no paid cloud / paid LLM keys required.

# API
SERVER_PORT=8080
# local profile uses H2 file DB (no Docker required)
# docker compose profile: set DB_* and use default application.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimbus
DB_USER=nimbus
DB_PASSWORD=nimbus
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000
DEV_LOGIN_ENABLED=true
JWT_SECRET=nimbus-local-dev-secret-change-me-32bytes-min

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI — local Ollama (default). No paid API keys.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Free (OAuth App). Optional — Dev Login works without these.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
# FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
