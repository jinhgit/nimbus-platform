# Nimbus is free-only: no paid cloud / paid LLM keys required.

# API
SERVER_PORT=8080
# local profile uses H2 file DB (no Docker required)
# docker compose profile: set DB_* and use default application.yml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimbus
DB_USER=nimbus
DB_PASSWORD=nimbus
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000
DEV_LOGIN_ENABLED=true
JWT_SECRET=nimbus-local-dev-secret-change-me-32bytes-min

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI — local Ollama (default). No paid API keys.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Free OAuth App — 로그인 + SCM 연결 (권장)
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Homepage: http://localhost:3000
# Authorization callback URL 은 앱당 1개만 가능하므로, SCM 콜백을 쓰려면
#   GITHUB_REDIRECT_URI 와 동일하게 SCM 콜백을 쓰거나 Callback URL 을 SCM 쪽으로 두고
#   로그인/SCM 을 같은 앱으로 운용. (또는 GitHub App 권장)
# 등록 예 (SCM 정식 연결):
#   Callback URL: http://localhost:8080/api/v1/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
FRONTEND_CALLBACK_URL=http://localhost:3000/auth/callback
GITHUB_SCM_REDIRECT_URI=http://localhost:8080/api/v1/github/oauth/callback
GITHUB_SCM_FRONTEND_CALLBACK=http://localhost:3000/settings
# GITHUB_SCM_SCOPES=repo workflow read:user user:email

# PAT 보조 연결 (OAuth 없을 때 Settings 에서 수동 입력)
# PAT 권한: repo (private 포함 시), workflow (선택)

# Local Kubernetes (k3d / kind only — free-only)
K8S_ENABLED=true
K8S_STRICT_LOCAL=true
# KUBECONFIG=/path/to/kubeconfig
K8S_DEMO_IMAGE=nginx:1.27-alpine
# kind: ./scripts/kind-up.sh
# k3d: ./scripts/k3d-up.sh

# Observability (make obs-up)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
