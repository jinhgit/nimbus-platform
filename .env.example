# Nimbus is free-only: no paid cloud / paid LLM keys required.

# API
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nimbus
DB_USER=nimbus
DB_PASSWORD=nimbus
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI — local Ollama (default). No paid API keys.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# GitHub Free (OAuth App — free account). Leave empty until Auth sprint.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Profile
# NIMBUS_PROFILE=local
